# Copy to docker/.env (git-ignored). Docker Compose reads this file twice:
#   1. to interpolate ${...} in compose.yaml (image, ports, limits, mounts), and
#   2. as `env_file` for the container (tracker secrets, runtime settings).
# Never commit real credentials.

# --- Compose: image and build -----------------------------------------------------------------
# Published image and tag. `latest` = newest release, `edge` = newest main build, `X.Y.Z` = pinned.
#SYMPHONY_IMAGE=ghcr.io/f8fvwgzc/texc-symphony
#SYMPHONY_IMAGE_TAG=latest
# missing (default): use the local image, else pull, else build | always | never | build
#SYMPHONY_PULL_POLICY=missing
# Build args used by `docker compose build`.
#INSTALL_CODEX=true
#CODEX_VERSION=0.160.0
# Enable optional overlays, e.g. the read-only host Codex login:
#COMPOSE_FILE=compose.yaml:compose.codex-auth.yaml
#CODEX_AUTH_JSON=~/.codex/auth.json

# --- Compose: networking ------------------------------------------------------------------------
# Host interface the dashboard/API is published on. The API has no authentication:
# keep 127.0.0.1 unless a firewall or an authenticating reverse proxy sits in front.
SYMPHONY_PUBLISH=127.0.0.1
# Host port the dashboard/API is published on (the container always listens on 4000).
# Deliberately NOT named SYMPHONY_PORT, so `docker run --env-file` never changes the in-container port.
SYMPHONY_HOST_PORT=4000

# --- Compose: mounts and limits -----------------------------------------------------------------
# Directory containing WORKFLOW.md, mounted read-only at /config.
#SYMPHONY_CONFIG_DIR=./config
#SYMPHONY_CPUS=4
#SYMPHONY_MEMORY=8g
#SYMPHONY_PIDS=4096

# --- Symphony runtime ---------------------------------------------------------------------------
# SQLite run history. Default /data/symphony.db (the symphony-data volume); `off` disables it.
#SYMPHONY_DB_PATH=/data/symphony.db
# Days of finished-run history to keep; 0 keeps everything.
#SYMPHONY_DB_RETENTION_DAYS=30
# Log root (default /data/logs, on the data volume); files are /data/logs/log/symphony.log*.
#SYMPHONY_LOGS_ROOT=/data/logs
# Format of the stdout log stream (`docker compose logs`): text (default) or json.
#SYMPHONY_LOG_FORMAT=text
# Workflow file inside the container (the default command passes /config/WORKFLOW.md).
#SYMPHONY_WORKFLOW=/config/WORKFLOW.md
# tracing filter, e.g. info, symphony=debug,info
#RUST_LOG=info
# SSH client config used for `worker.ssh_hosts` (mount it into the container as well).
#SYMPHONY_SSH_CONFIG=/home/symphony/.ssh/config

# --- Tracker credentials (only the one your WORKFLOW.md uses) -----------------------------------
# These stay host-side: Symphony strips them from the Codex child environment.
LINEAR_API_KEY=
#GITHUB_TOKEN=
#GITLAB_PAT=
#JIRA_BASE_URL=https://your-site.atlassian.net
#JIRA_EMAIL=
#JIRA_API_TOKEN=
#ASANA_PAT=

# --- Agent / workspace hooks --------------------------------------------------------------------
# Anything your WORKFLOW.md hooks reference, e.g. the repository to clone into each workspace.
#SOURCE_REPO_URL=https://github.com/your-org/your-repo.git
# Commit identity for agent commits.
#GIT_AUTHOR_NAME=Symphony Agent
#GIT_AUTHOR_EMAIL=symphony@example.com
#GIT_COMMITTER_NAME=Symphony Agent
#GIT_COMMITTER_EMAIL=symphony@example.com
